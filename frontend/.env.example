# Next.js only loads env from this directory. Copy to .env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional cookieless visitor analytics (Plausible). Leave empty to disable.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=analyticsages.io

# Optional advertising pixels. Empty = Meta/Google scripts and the cookie banner stay off.
# Set these on Vercel for production. NEXT_PUBLIC_* is baked in at build — redeploy after changing.
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
