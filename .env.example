# =============================================================================
# Analytic Sages — Environment Variables (template)
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Database ---
POSTGRES_USER=analyticsages
POSTGRES_PASSWORD=changeme
POSTGRES_DB=analyticsages
DATABASE_URL=postgresql://analyticsages:changeme@localhost:5434/analyticsages

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=changeme-generate-a-secure-random-key
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies (COOKIE_SECURE=true automatically in production)
# The Next.js app proxies /api/* to this backend, so refresh cookies are first-party
# on the marketing origin. SameSite=Lax is correct. Do not point the browser at the
# API host directly.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Auth rate limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (Next.js) ---
# Next.js does not load this root .env. Copy frontend/.env.example to
# frontend/.env.local. NEXT_PUBLIC_API_URL is the rewrite *destination* (this API).
# The browser calls same-origin /api and Next proxies it here.

# --- Authentication (Phase 2 — custom auth) ---
# Google OAuth — leave empty for mock Google login in development.
# Redirect URI must be the public site (same-origin /api rewrite), not the API host:
#   GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Production: https://www.analyticsages.io/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Bunny Stream (premium recorded courses) ---
# BUNNY_API_KEY=
# BUNNY_LIBRARY_ID=
# BUNNY_CDN_HOSTNAME=

# --- Cloudflare RealtimeKit (live classroom) ---
# Leave empty for mock classroom mode (UI works without live media).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# REALTIMEKIT_APP_ID=
# REALTIMEKIT_HOST_PRESET=group_call_host
# REALTIMEKIT_PARTICIPANT_PRESET=group_call_participant

# Article image uploads (local disk on the API host). Not Postgres.
# STORAGE_DIR=var/uploads
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Payments ---
# PAYMENT_MODE=mock keeps all providers on mock adapters (recommended for local MVP).
# Leave live keys empty until you are ready to switch a provider to LIVE.
PAYMENT_MODE=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# Cohort tuition plans / installments. Off keeps legacy one-time cohort checkout.
# BILLING_PLANS_ENABLED=true

# Referral Partner Program — 7% commission on eligible successful learner payments
# DEFAULT_REFERRAL_COMMISSION_RATE=0.07
# REFERRAL_ATTRIBUTION_DAYS=30
# COMMISSION_HOLD_DAYS=14
# MINIMUM_PAYOUT_AMOUNT=10000
# MINIMUM_PAYOUT_CURRENCY=NGN
# REFERRAL_DEFAULT_REDIRECT_PATH=/programs
# REFERRAL_RELEASE_TOKEN=

# Paystack (cards / bank) — empty secret = mock; with secret = live initialize + webhook
# Dashboard webhook URL:
#   {PUBLIC_API_URL}/api/v1/webhooks/payments/paystack
# Most NG merchants charge in NGN. USD catalog prices convert at PAYSTACK_USD_TO_NGN_RATE.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_API_URL=https://api.paystack.co
# PAYSTACK_CHARGE_CURRENCY=NGN
# PAYSTACK_USD_TO_NGN_RATE=1600

# Public API base URL for provider webhooks (NOWPayments IPN / Paystack). Use HTTPS in production.
# For local IPN testing, set to an ngrok/cloudflare tunnel URL pointing at this API.
PUBLIC_API_URL=http://localhost:8000

# NOWPayments (crypto) — empty API key = mock checkout; with key = live invoice + IPN
# Dashboard: create IPN secret, then set IPN URL to:
#   {PUBLIC_API_URL}/api/v1/webhooks/payments/nowpayments
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# NOWPAYMENTS_PRICE_CURRENCY=USD

# --- Email (Resend) ---
# Without EMAIL_API_KEY, verification/reset links are logged in the backend console (dev).
# With a Resend API key, emails are sent for real. Verify the from-domain in Resend.
# EMAIL_API_KEY=re_xxxxxxxx
EMAIL_FROM=Analytic Sages <noreply@analyticsages.com>
# CONTACT_EMAIL=support@analyticsages.io
# Insights subscribe + first-publish send. Create an Audience (now called Segment) in Resend.
# Custom one-off emails: send a Broadcast to this same list from the Resend dashboard.
# RESEND_AUDIENCE_ID=

# Optional header token for GitHub Actions to sync sources and send the weekly opportunities digest.
# OPPORTUNITY_SYNC_TOKEN=

# Public opportunities hub. Leave unset/false until go-live. Also set
# NEXT_PUBLIC_OPPORTUNITIES_PUBLIC=true in frontend/.env.local and Vercel, then redeploy.
# OPPORTUNITIES_PUBLIC=true

# Referral Partner programme public pages. Leave unset until go-live.
# NEXT_PUBLIC_PARTNERS_PUBLIC=true in frontend/.env.local and Vercel, then redeploy.
# PARTNERS_PUBLIC=true

# Telegram announcements on publish. Leave empty to skip.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=

# Optional LLM review assist and typed discovery for admins. Never auto-publishes.
# OpenAI is tried first; Gemini is used if OpenAI is missing or fails.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional cookieless visitor analytics (Plausible). Set in frontend/.env.local:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=analyticsages.io

# Optional advertising pixels (Meta + Google Ads). Empty = scripts and cookie banner off.
# Set in frontend/.env.local and Vercel. NEXT_PUBLIC_* is baked in at build — redeploy after changing.
# Pixel / Ads IDs are not secrets, but do not commit production values if you prefer to keep them in Vercel only.
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# --- Monitoring ---
# SENTRY_DSN=
