# =============================================================================
# Analytic Sages — Environment Variables (template)
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Database ---
POSTGRES_USER=analyticsages
POSTGRES_PASSWORD=changeme
POSTGRES_DB=analyticsages
DATABASE_URL=postgresql://analyticsages:changeme@localhost:5434/analyticsages

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=changeme-generate-a-secure-random-key
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies (COOKIE_SECURE=true automatically in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Auth rate limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (Next.js) ---
# Next.js does not load this root .env. Copy frontend/.env.example to
# frontend/.env.local and set NEXT_PUBLIC_API_URL there.

# --- Authentication (Phase 2 — custom auth) ---
# Google OAuth — leave empty for mock Google login in development
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Bunny Stream (premium recorded courses) ---
# BUNNY_API_KEY=
# BUNNY_LIBRARY_ID=
# BUNNY_CDN_HOSTNAME=

# --- Cloudflare RealtimeKit (live classroom) ---
# Leave empty for mock classroom mode (UI works without live media).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# REALTIMEKIT_APP_ID=
# REALTIMEKIT_HOST_PRESET=group_call_host
# REALTIMEKIT_PARTICIPANT_PRESET=group_call_participant

# --- Object Storage (R2 / GCS) ---
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Payments ---
# PAYMENT_MODE=mock keeps all providers on mock adapters (recommended for local MVP).
# Leave live keys empty until you are ready to switch a provider to LIVE.
PAYMENT_MODE=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# Paystack (cards / bank) — empty secret = mock; with secret = live initialize + webhook
# Dashboard webhook URL:
#   {PUBLIC_API_URL}/api/v1/webhooks/payments/paystack
# Most NG merchants charge in NGN. USD catalog prices convert at PAYSTACK_USD_TO_NGN_RATE.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_API_URL=https://api.paystack.co
# PAYSTACK_CHARGE_CURRENCY=NGN
# PAYSTACK_USD_TO_NGN_RATE=1600

# Public API base URL for provider webhooks (NOWPayments IPN / Paystack). Use HTTPS in production.
# For local IPN testing, set to an ngrok/cloudflare tunnel URL pointing at this API.
PUBLIC_API_URL=http://localhost:8000

# NOWPayments (crypto) — empty API key = mock checkout; with key = live invoice + IPN
# Dashboard: create IPN secret, then set IPN URL to:
#   {PUBLIC_API_URL}/api/v1/webhooks/payments/nowpayments
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# NOWPAYMENTS_PRICE_CURRENCY=USD

# --- Email (Resend) ---
# Without EMAIL_API_KEY, verification/reset links are logged in the backend console (dev).
# With a Resend API key, emails are sent for real. Verify the from-domain in Resend.
# EMAIL_API_KEY=re_xxxxxxxx
EMAIL_FROM=Analytic Sages <noreply@analyticsages.com>
# CONTACT_EMAIL=support@analyticsages.io

# Optional cookieless visitor analytics (Plausible). Set in frontend/.env.local:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=analyticsages.io

# --- Monitoring ---
# SENTRY_DSN=
